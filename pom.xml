<?xml version="1.0" encoding="UTF-8"?>

<!--
    Энэ pom.xml файл нь user-soap-service Spring Boot project-ийн Maven тохиргоо юм.

    Энэ service нь SOAP authentication service бөгөөд:
    - RegisterUser
    - LoginUser
    - ValidateToken

    гэсэн SOAP operation-уудыг ажиллуулна.

    Мөн PostgreSQL database ашиглаж auth_user table дээр
    register хийсэн хэрэглэгчдийг хадгалдаг.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- Maven project model version -->
    <modelVersion>4.0.0</modelVersion>

    <!--
        Spring Boot parent.
        Энэ parent нь Spring Boot dependency version-уудыг автоматаар удирдаж өгдөг.
        Тиймээс dependency бүр дээр version бичих шаардлага багасна.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.3</version>
        <relativePath/>
    </parent>

    <!-- Project-ийн үндсэн мэдээлэл -->
    <groupId>com.example</groupId>
    <artifactId>user-soap-service</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>user-soap-service</name>
    <description>SOAP Authentication Service</description>

    <properties>
        <!-- Project Java 21 дээр build хийгдэнэ -->
        <java.version>21</java.version>
    </properties>

    <dependencies>

        <!--
            SOAP / Web Services dependency.

            Spring Web Services ашиглаж SOAP endpoint үүсгэхэд хэрэгтэй.
            @Endpoint, @PayloadRoot, MessageDispatcherServlet зэрэг SOAP-той холбоотой
            component-ууд энэ starter-аар орж ирнэ.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webservices</artifactId>
        </dependency>

        <!--
            WSDL generation dependency.

            SOAP service-ийн WSDL үүсгэхэд ашиглагдана.
            WSDL нь service ямар operation, request, response-тэй болохыг тодорхойлдог.
        -->
        <dependency>
            <groupId>wsdl4j</groupId>
            <artifactId>wsdl4j</artifactId>
        </dependency>

        <!--
            Database / JPA dependency.

            Spring Data JPA ашиглаж PostgreSQL database-тэй entity/repository хэлбэрээр
            ажиллахад хэрэгтэй.

            Энэ project дээр AuthUser entity болон AuthUserRepository ашиглаж
            auth_user table дээр register хийсэн хэрэглэгчдийг хадгалж байна.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!--
            PostgreSQL JDBC driver.

            Spring Boot application PostgreSQL database руу холбогдоход энэ driver хэрэгтэй.
            runtime scope гэдэг нь compile үед биш, application ажиллах үед хэрэгтэй dependency гэсэн үг.
        -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            Lombok dependency.

            Getter, setter, constructor зэрэг boilerplate code багасгахад ашиглаж болно.
            Энэ project дээр зарим class гараар getter/setter бичсэн ч Lombok dependency үлдсэн байгаа.
            optional=true тул энэ dependency project ашиглаж буй бусад module руу заавал дамжихгүй.
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            Test dependency.

            SOAP/Web Service test бичихэд ашиглагдана.
            scope=test тул зөвхөн test compile/run үед хэрэглэгдэнэ.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webservices-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>

            <!--
                JAXB2 Maven Plugin.

                Энэ plugin нь XSD schema файлуудаас Java class generate хийдэг.
                Манай auth.xsd дээр RegisterUserRequest, LoginUserRequest,
                ValidateTokenRequest зэрэг XML element-үүд тодорхойлогдсон.

                Build хийх үед plugin эдгээр element-үүдэд тохирох Java class-уудыг
                target/generated-sources/jaxb дотор үүсгэнэ.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>jaxb2-maven-plugin</artifactId>
                <version>3.1.0</version>

                <executions>
                    <execution>
                        <!-- xjc goal нь XSD -> Java class generation хийдэг -->
                        <id>xjc</id>
                        <goals>
                            <goal>xjc</goal>
                        </goals>
                    </execution>
                </executions>

                <configuration>
                    <!-- XSD schema байрлаж байгаа folder -->
                    <sources>
                        <source>src/main/resources/schema</source>
                    </sources>

                    <!-- Generate болсон Java class-уудын package нэр -->
                    <packageName>com.example.authsoap</packageName>

                    <!-- Generate болсон source code гарах folder -->
                    <outputDirectory>${project.build.directory}/generated-sources/jaxb</outputDirectory>

                    <!--
                        false болгосноор output directory бүрэн цэвэрлэгдэхгүй.
                        Ингэснээр build хийх үед schema-аас үүссэн class-ууд хадгалагдана.
                    -->
                    <clearOutputDir>false</clearOutputDir>
                </configuration>
            </plugin>

            <!--
                Maven Compiler Plugin.

                Lombok annotation processor тохируулахад ашиглаж байна.
                Хэрэв Lombok annotation ашигласан class байвал compile үед annotation processing хийнэ.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>

                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!--
                Spring Boot Maven Plugin.

                Энэ plugin нь project-ийг executable jar болгож package хийнэ.
                Droplet дээр systemd service энэ jar файлыг java -jar командаар ажиллуулдаг.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>

                <configuration>
                    <excludes>
                        <!--
                            Lombok нь compile-time хэрэгсэл тул final jar дотор оруулах шаардлагагүй.
                        -->
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>